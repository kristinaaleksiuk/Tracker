<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль 1: заголовок (TextAppearance) -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль 2: вторичный текст -->
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Стиль 3: карточка -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/corner</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Стиль 4: основная кнопка -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner</item>
    </style>

    <!-- Стиль 5: второстепенная кнопка -->
    <style name="Widget.App.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner</item>
    </style>

    <!-- Стиль 6: поле ввода -->
    <style name="Widget.App.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="errorEnabled">true</item>
    </style>
</resources>

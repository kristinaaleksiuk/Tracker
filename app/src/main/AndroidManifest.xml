<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ExpenseApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AddExpenseActivity" android:exported="false"
            android:label="@string/add_title" />
        <activity android:name=".ui.CategoryActivity" android:exported="false"
            android:label="@string/choose_category" />
        <activity android:name=".ui.StatsActivity" android:exported="false"
            android:label="@string/stats_title" />
    </application>
</manifest>
